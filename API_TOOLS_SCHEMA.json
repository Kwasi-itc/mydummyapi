{
  "apiInfo": {
    "baseUrl": "http://localhost:3000",
    "version": "1.0.0",
    "description": "Fintech Agent API - Dummy endpoints for intelligent agent chatbot workflows"
  },
  "endpoints": {
    "system": {
      "health": {
        "method": "GET",
        "path": "/health",
        "description": "Health check endpoint",
        "parameters": {},
        "responseType": "object",
        "checker": false
      }
    },
    "treasury": {
      "tBillCalculator": {
        "method": "GET",
        "path": "/treasury/tbills/calculate",
        "description": "Calculate Ghana treasury bill returns",
        "parameters": {
          "query": ["investmentAmount", "tenor", "discountRate", "issueDate"]
        },
        "responseType": "object",
        "checker": false,
        "workflowUse": "Pre-bid projections for 91/182/364 day bills"
      }
    },
    "fx": {
      "exchangeRate": {
        "method": "GET",
        "path": "/fx/exchange-rate",
        "description": "Get exchange rate between two currencies",
        "parameters": {
          "query": ["from", "to", "amount"]
        },
        "responseType": "object",
        "checker": false
      }
    },
    "accounts": {
      "list": {
        "method": "GET",
        "path": "/accounts",
        "description": "List all accounts with optional filters",
        "parameters": {
          "query": ["customerId", "status", "type", "currency"]
        },
        "responseType": "array",
        "checker": false
      },
      "get": {
        "method": "POST",
        "path": "/accounts/get",
        "description": "Get account details by ID",
        "parameters": {
          "body": {
            "required": ["accountId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "create": {
        "method": "POST",
        "path": "/accounts",
        "description": "Create a new account",
        "parameters": {
          "body": {
            "required": ["customerId", "type", "currency"],
            "optional": ["initialDeposit", "kycLevel"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "updateStatus": {
        "method": "POST",
        "path": "/accounts/update-status",
        "description": "Update account status",
        "parameters": {
          "body": {
            "required": ["accountId", "status"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "checkActive": {
        "method": "GET",
        "path": "/accounts/check-active",
        "description": "Checker: Verify if account is active",
        "parameters": {
          "query": ["accountId"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Pre-transaction validation"
      }
    },
    "transactions": {
      "list": {
        "method": "GET",
        "path": "/transactions",
        "description": "List transactions with optional filters",
        "parameters": {
          "query": ["accountId", "status", "type", "dateFrom", "dateTo"]
        },
        "responseType": "array",
        "checker": false
      },
      "get": {
        "method": "POST",
        "path": "/transactions/get",
        "description": "Get transaction details by ID",
        "parameters": {
          "body": {
            "required": ["txnId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "create": {
        "method": "POST",
        "path": "/transactions",
        "description": "Create a new transaction/transfer",
        "parameters": {
          "body": {
            "required": ["fromAccount", "toAccount", "amount", "currency"],
            "optional": ["purpose"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "checkCleared": {
        "method": "GET",
        "path": "/transactions/check-cleared",
        "description": "Checker: Verify if transaction has been cleared",
        "parameters": {
          "query": ["txnId"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Post-transaction confirmation"
      }
    },
    "payments": {
      "initiate": {
        "method": "POST",
        "path": "/payments/initiate",
        "description": "Initiate a payment/payout",
        "parameters": {
          "body": {
            "required": ["accountId", "beneficiary", "beneficiaryAccount", "amount", "currency"],
            "optional": ["method", "reference"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "get": {
        "method": "POST",
        "path": "/payments/get",
        "description": "Get payment details by ID",
        "parameters": {
          "body": {
            "required": ["paymentId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "cancel": {
        "method": "POST",
        "path": "/payments/cancel",
        "description": "Cancel a pending payment",
        "parameters": {
          "body": {
            "required": ["paymentId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "checkReady": {
        "method": "GET",
        "path": "/payments/check-ready",
        "description": "Checker: Verify if payment is ready to process",
        "parameters": {
          "query": ["paymentId"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Pre-payment validation"
      }
    },
    "loans": {
      "apply": {
        "method": "POST",
        "path": "/loans/apply",
        "description": "Submit a loan application",
        "parameters": {
          "body": {
            "required": [
              "customerId",
              "accountId",
              "loan_type",
              "loan_amount",
              "loan_purpose",
              "annual_income",
              "employment_status",
              "preferred_term_months"
            ]
          }
        },
        "responseType": "object",
        "checker": false,
        "validation": {
          "loan_type": {
            "enum": ["personal", "business"],
            "type": "string",
            "required": true,
            "description": "What type of loan are you looking for - personal or business"
          },
          "loan_amount": {
            "max": 1000000,
            "min": 1000,
            "type": "number",
            "required": true,
            "description": "How much would you like to borrow (in GH₵)"
          },
          "loan_purpose": {
            "type": "string",
            "required": true,
            "description": "What is the purpose of this loan"
          },
          "annual_income": {
            "min": 0,
            "type": "number",
            "required": true,
            "description": "What is your annual income (in GH₵)"
          },
          "employment_status": {
            "enum": ["employed", "self-employed", "unemployed", "retired"],
            "type": "string",
            "required": true,
            "description": "What is your current employment status"
          },
          "preferred_term_months": {
            "max": 360,
            "min": 6,
            "type": "number",
            "required": true,
            "description": "What loan term would you prefer (in months)"
          }
        }
      },
      "get": {
        "method": "POST",
        "path": "/loans/get",
        "description": "Get loan application details by ID",
        "parameters": {
          "body": {
            "required": ["loanId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "list": {
        "method": "GET",
        "path": "/loans",
        "description": "List loans with optional filters",
        "parameters": {
          "query": ["customerId", "status", "dateFrom"]
        },
        "responseType": "array",
        "checker": false
      },
      "checkEligible": {
        "method": "GET",
        "path": "/loans/check-eligible",
        "description": "Checker: Verify loan eligibility",
        "parameters": {
          "query": ["loanId"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Pre-approval validation"
      },
      "checkApproved": {
        "method": "GET",
        "path": "/loans/check-approved",
        "description": "Checker: Verify loan approval status",
        "parameters": {
          "query": ["loanId"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Pre-disbursement validation"
      },
      "repaymentCalculator": {
        "method": "GET",
        "path": "/loans/repayments/calculate",
        "description": "Loan repayment calculator for monthly installments and amortization schedules",
        "parameters": {
          "query": ["principal", "annualRate", "termMonths", "startDate", "extraPayment"]
        },
        "responseType": "object",
        "checker": false,
        "workflowUse": "Answer installment/payoff questions before loan origination"
      },
      "approve": {
        "method": "POST",
        "path": "/loans/approve",
        "description": "Approve a loan (admin action)",
        "parameters": {
          "body": {
            "required": ["loanId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "reject": {
        "method": "POST",
        "path": "/loans/reject",
        "description": "Reject a loan application",
        "parameters": {
          "body": {
            "required": ["loanId"],
            "optional": ["reason"]
          }
        },
        "responseType": "object",
        "checker": false
      }
    },
    "airtime": {
      "listProviders": {
        "method": "GET",
        "path": "/airtime/providers",
        "description": "List available airtime providers/networks",
        "parameters": {},
        "responseType": "array",
        "checker": false
      },
      "purchase": {
        "method": "POST",
        "path": "/airtime/purchase",
        "description": "Purchase airtime",
        "parameters": {
          "body": {
            "required": ["phoneNumber", "amount", "provider", "accountId"],
            "optional": ["currency"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "getPurchase": {
        "method": "POST",
        "path": "/airtime/purchases/get",
        "description": "Get airtime purchase details by ID",
        "parameters": {
          "body": {
            "required": ["purchaseId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "listPurchases": {
        "method": "GET",
        "path": "/airtime/purchases",
        "description": "List airtime purchases with optional filters",
        "parameters": {
          "query": ["accountId", "phoneNumber", "status", "dateFrom"]
        },
        "responseType": "array",
        "checker": false
      },
      "checkCompleted": {
        "method": "GET",
        "path": "/airtime/purchases/check-completed",
        "description": "Checker: Verify if airtime purchase is completed",
        "parameters": {
          "query": ["purchaseId"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Post-purchase confirmation"
      }
    },
    "kyc": {
      "get": {
        "method": "POST",
        "path": "/kyc/customers/get",
        "description": "Get KYC status for a customer",
        "parameters": {
          "body": {
            "required": ["customerId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "refresh": {
        "method": "POST",
        "path": "/kyc/customers/refresh",
        "description": "Refresh KYC check",
        "parameters": {
          "body": {
            "required": ["customerId"],
            "optional": ["documents", "level"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "checkApproved": {
        "method": "GET",
        "path": "/kyc/customers/check-approved",
        "description": "Checker: Verify if KYC is approved",
        "parameters": {
          "query": ["customerId"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Pre-transaction validation"
      }
    },
    "limits": {
      "get": {
        "method": "POST",
        "path": "/limits/get",
        "description": "Get account transaction limits",
        "parameters": {
          "body": {
            "required": ["accountId"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "update": {
        "method": "POST",
        "path": "/limits/update",
        "description": "Update account transaction limits",
        "parameters": {
          "body": {
            "required": ["accountId"],
            "optional": ["dailyLimit", "monthlyLimit"]
          }
        },
        "responseType": "object",
        "checker": false
      },
      "checkAvailable": {
        "method": "GET",
        "path": "/limits/check-available",
        "description": "Checker: Verify if limit is available for a transaction",
        "parameters": {
          "query": ["accountId", "amount", "period"]
        },
        "responseType": "checker",
        "checker": true,
        "workflowUse": "Pre-transaction validation"
      }
    }
  },
  "workflows": {
    "paymentProcessing": {
      "name": "Payment Processing Workflow",
      "description": "Process a payment with all prerequisite checks",
      "steps": [
        {
          "step": 1,
          "endpoint": "accounts.checkActive",
          "description": "Check account is active",
          "condition": "result must be true"
        },
        {
          "step": 2,
          "endpoint": "kyc.checkApproved",
          "description": "Check KYC is approved",
          "condition": "result must be true"
        },
        {
          "step": 3,
          "endpoint": "limits.checkAvailable",
          "description": "Check limit is available",
          "condition": "result must be true"
        },
        {
          "step": 4,
          "endpoint": "payments.initiate",
          "description": "Initiate payment"
        },
        {
          "step": 5,
          "endpoint": "payments.checkReady",
          "description": "Check payment is ready",
          "condition": "result must be true"
        }
      ]
    },
    "loanApplication": {
      "name": "Loan Application Workflow",
      "description": "Process loan application with eligibility and approval checks",
      "steps": [
        {
          "step": 1,
          "endpoint": "loans.apply",
          "description": "Submit loan application"
        },
        {
          "step": 2,
          "endpoint": "loans.checkEligible",
          "description": "Check loan eligibility",
          "condition": "result must be true"
        },
        {
          "step": 3,
          "endpoint": "kyc.checkApproved",
          "description": "Check KYC is approved",
          "condition": "result must be true"
        },
        {
          "step": 4,
          "endpoint": "loans.approve",
          "description": "Approve loan"
        },
        {
          "step": 5,
          "endpoint": "loans.checkApproved",
          "description": "Verify approval",
          "condition": "result must be true"
        }
      ]
    },
    "airtimePurchase": {
      "name": "Airtime Purchase Workflow",
      "description": "Purchase airtime and verify delivery",
      "steps": [
        {
          "step": 1,
          "endpoint": "airtime.listProviders",
          "description": "Get available providers"
        },
        {
          "step": 2,
          "endpoint": "airtime.purchase",
          "description": "Purchase airtime"
        },
        {
          "step": 3,
          "endpoint": "airtime.checkCompleted",
          "description": "Check completion (poll until complete)",
          "condition": "result must be true",
          "retry": true
        }
      ]
    }
  },
  "checkerEndpoints": [
    {
      "endpoint": "accounts.checkActive",
      "path": "/accounts/check-active",
      "purpose": "Verify account is active",
      "useCase": "Pre-transaction validation"
    },
    {
      "endpoint": "transactions.checkCleared",
      "path": "/transactions/check-cleared",
      "purpose": "Verify transaction cleared",
      "useCase": "Post-transaction confirmation"
    },
    {
      "endpoint": "payments.checkReady",
      "path": "/payments/check-ready",
      "purpose": "Verify payment ready to process",
      "useCase": "Pre-payment validation"
    },
    {
      "endpoint": "loans.checkEligible",
      "path": "/loans/check-eligible",
      "purpose": "Verify loan eligibility",
      "useCase": "Pre-approval validation"
    },
    {
      "endpoint": "loans.checkApproved",
      "path": "/loans/check-approved",
      "purpose": "Verify loan approved",
      "useCase": "Pre-disbursement validation"
    },
    {
      "endpoint": "airtime.checkCompleted",
      "path": "/airtime/purchases/check-completed",
      "purpose": "Verify airtime delivered",
      "useCase": "Post-purchase confirmation"
    },
    {
      "endpoint": "kyc.checkApproved",
      "path": "/kyc/customers/check-approved",
      "purpose": "Verify KYC approved",
      "useCase": "Pre-transaction validation"
    },
    {
      "endpoint": "limits.checkAvailable",
      "path": "/limits/check-available",
      "purpose": "Verify limit available",
      "useCase": "Pre-transaction validation"
    }
  ],
  "responseFormats": {
    "success": {
      "status": "success",
      "data": "object|array",
      "count": "number (for lists)",
      "timestamp": "ISO 8601 string",
      "requestId": "string"
    },
    "error": {
      "status": "error",
      "message": "string",
      "timestamp": "ISO 8601 string",
      "requestId": "string"
    },
    "checker": {
      "result": "boolean",
      "reason": "string",
      "metadata": "object",
      "timestamp": "ISO 8601 string",
      "requestId": "string"
    }
  }
}

